<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dimen_16"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimen_16">

        <!-- Icon Container -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dimen_4"
            android:backgroundTint="@color/primary_light"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgDialogIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_calendar_outlined"
                app:tint="@color/primary" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/txtDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_4"
            android:gravity="center"
            android:text="Schedule Created"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_semi_bold"
            android:includeFontPadding="false" />

        <!-- Message -->
        <TextView
            android:id="@+id/txtDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_16"
            android:gravity="center"
            android:text="Would you like to create a stopover for this schedule?"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_small"
            android:fontFamily="@font/montserrat_regular"
            android:lineSpacingExtra="2dp" />

        <!-- Button Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Create Schedule Only Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateScheduleOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_8"
                android:minWidth="100dp"
                android:text="Schedule Only"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/montserrat_semi_bold"
                style="@style/Widget.Material3.Button.TextButton"
                app:cornerRadius="6dp" />

            <!-- Create Stopover Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateStopover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:text="Create Stopover"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/montserrat_semi_bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="6dp"
                app:rippleColor="@color/primary_dark" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
